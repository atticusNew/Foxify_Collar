{
  "name": "@foxify/snapshot-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "description": "Read-only background worker that polls the live Foxify pilot admin endpoints, persists raw snapshots, and computes derived salvage / regime / rule-firing metrics.",
  "dependencies": {
    "decimal.js": "^10.4.3",
    "pg": "^8.20.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.18.0",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "type-check": "tsc --noEmit"
  }
}
